<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <br>
        <h3><%= listing.title %></h3> <br>
        <div class="card show-card listing-card">
            <img src="<%=listing.image%>" class="card-img-top show-img" alt="Listing_image">
            <div class="card-body">
                <p class="card-text"> Owned by <i> <%= listing.owner.username %> </i> </p>
                <p class="card-text"></p> <%= listing.description %> </p>
                <p class="card-text"></p> &#8377;<%= listing.price.toLocaleString("en-IN")%> </p>
                <p class="card-text"></p> <%= listing.location%> </p>
                <p class="card-text"></p> <%= listing.country%> </p>
            </div>
        </div>
        <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="row show-btn">
            <div>
                <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark">Edit</a>
            </div>
            <div>
                <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
                    <button class="btn btn-dark add-btn">Delete</button>
                </form>
            </div>
        </div> 
        <% } %>
        <hr>
        <!-- for taking review -->
        <% if(currUser) { %>
        <div>
            <h4>Leave a review</h4>
            <form action="/listings/<%=listing._id%>/reviews" method="POST"novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" class="form-control" min="1" max="5" id="rating" name="review[rating]" >
                </div>
                <div class="mb-3 mt-3 ">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
                    <div class="invalid-feedback">please write a comment</div>
                </div>
                <button class="btn btn-outline-dark mb-3">Submit</button>
            </form>
        </div> 
        <hr>
        <% } %>
        <!-- Show all reviews -->
        <div>
            <h4>All Reviews</h4>
            
            <% if(!listing.reviews.length){ %>
                <p>No reviews yet</p>
            <% } %>
            <div class="row">
                <% for(let review of listing.reviews){ %>
                    <div class="card col-5 m-3">
                        <div class="card-body">
                            <h6 class="card-title">@<%= review.author.username %></h6>
                            <p class="card-text"><%= review.rating %> Star</p>
                            <p class="card-text"><%= review.comment %></p>
                            <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mb-3" method="POST"><button class="btn btn-sm btn-dark">DELETE</button></form>
                        </div>
                    </div>
                <%} %>
            </div>
        </div>
    </div> 
</div>
